{
  "title": "ndpi-observe",
  "uid": "ndpi-observe",
  "schemaVersion": 38,
  "version": 2,
  "refresh": "10s",
  "panels": [
    {
      "id": 1,
      "title": "Active Flows",
      "type": "stat",
      "gridPos": {"x": 0, "y": 0, "w": 4, "h": 4},
      "targets": [{
        "expr": "ndpi_observe_flows_active",
        "legendFormat": "active"
      }]
    },
    {
      "id": 2,
      "title": "Flows Created (total)",
      "type": "stat",
      "gridPos": {"x": 4, "y": 0, "w": 4, "h": 4},
      "targets": [{
        "expr": "ndpi_observe_flows_created_total",
        "legendFormat": "created"
      }]
    },
    {
      "id": 6,
      "title": "Total Throughput",
      "type": "stat",
      "gridPos": {"x": 8, "y": 0, "w": 4, "h": 4},
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "color": {"mode": "thresholds"},
          "thresholds": {"steps": [{"color": "green", "value": null}]}
        }
      },
      "targets": [{
        "expr": "sum(rate(ndpi_observe_app_bytes_total[1m])) * 8",
        "legendFormat": "bps"
      }]
    },
    {
      "id": 7,
      "title": "Total Packet Rate",
      "type": "stat",
      "gridPos": {"x": 12, "y": 0, "w": 4, "h": 4},
      "fieldConfig": {
        "defaults": {
          "unit": "pps",
          "color": {"mode": "thresholds"},
          "thresholds": {"steps": [{"color": "green", "value": null}]}
        }
      },
      "targets": [{
        "expr": "sum(rate(ndpi_observe_app_packets_total[1m]))",
        "legendFormat": "pps"
      }]
    },
    {
      "id": 3,
      "title": "Packets Scanned vs Cached",
      "type": "timeseries",
      "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8},
      "targets": [
        {
          "expr": "rate(ndpi_observe_packets_scanned_total[1m])",
          "legendFormat": "scanned/s"
        },
        {
          "expr": "rate(ndpi_observe_packets_fastpath_total[1m])",
          "legendFormat": "fastpath/s (in-kernel)"
        }
      ]
    },
    {
      "id": 5,
      "title": "Top Applications by Bytes",
      "type": "bargauge",
      "gridPos": {"x": 12, "y": 4, "w": 12, "h": 8},
      "targets": [{
        "expr": "topk(10, ndpi_observe_app_bytes_total)",
        "legendFormat": "{{app}}"
      }],
      "options": {
        "orientation": "horizontal",
        "reduceOptions": {"calcs": ["lastNotNull"]}
      }
    },
    {
      "id": 8,
      "title": "Bits/s per Application",
      "type": "timeseries",
      "gridPos": {"x": 0, "y": 12, "w": 24, "h": 10},
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "custom": {"lineWidth": 1, "fillOpacity": 10}
        }
      },
      "targets": [{
        "expr": "topk(10, rate(ndpi_observe_app_bytes_total[1m])) * 8",
        "legendFormat": "{{app}}"
      }]
    },
    {
      "id": 9,
      "title": "Packets/s per Application",
      "type": "timeseries",
      "gridPos": {"x": 0, "y": 22, "w": 24, "h": 10},
      "fieldConfig": {
        "defaults": {
          "unit": "pps",
          "custom": {"lineWidth": 1, "fillOpacity": 10}
        }
      },
      "targets": [{
        "expr": "topk(10, rate(ndpi_observe_app_packets_total[1m]))",
        "legendFormat": "{{app}}"
      }]
    },
    {
      "id": 10,
      "title": "ndpid CPU Usage",
      "type": "timeseries",
      "gridPos": {"x": 0, "y": 32, "w": 12, "h": 8},
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {"lineWidth": 2, "fillOpacity": 15}
        }
      },
      "targets": [{
        "expr": "rate(process_cpu_seconds_total{job=\"ndpi-observe\"}[1m])",
        "legendFormat": "CPU %"
      }]
    },
    {
      "id": 11,
      "title": "ndpid Memory (RSS)",
      "type": "timeseries",
      "gridPos": {"x": 12, "y": 32, "w": 12, "h": 8},
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {"lineWidth": 2, "fillOpacity": 15}
        }
      },
      "targets": [{
        "expr": "process_resident_memory_bytes{job=\"ndpi-observe\"}",
        "legendFormat": "RSS"
      }]
    }
  ]
}
