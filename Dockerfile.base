FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    # Build tools
    gcc clang llvm make \
    # BPF tools
    linux-headers-generic libbpf-dev linux-tools-generic \
    # nDPI
    libndpi-dev \
    # Test / network tools
    python3 python3-pip python3-scapy \
    iproute2 tcpdump net-tools \
    # Misc
    curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN pip3 install --no-cache-dir --break-system-packages pytest

WORKDIR /src
